classDiagram
    class Category {
        <<enumeration>>
        WALK
        FEED
        MEDS
        ENRICHMENT
        GROOMING
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Owner {
        +string name
        +dict preferences
        +time day_start_time
        +time day_end_time
        +list~TimeBlock~ busy_blocks
        +list~Pet~ pets
        +all_tasks() list~Task~
    }

    class Pet {
        +string id
        +string name
        +string species
        +string notes
        +list~Task~ tasks
    }

    class TimeBlock {
        +time start_time
        +time end_time
        +string label
        +overlaps(other) bool
    }

    class Task {
        +string id
        +string title
        +Category category
        +int duration_minutes
        +Priority priority
        +TimeBlock preferred_time_window
        +bool is_required
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time
        +overlaps(other) bool
    }

    class Scheduler {
        +generate_plan(tasks, owner) DailyPlan
        -_get_free_windows(owner) list~TimeBlock~
        -_sort_by_priority(tasks) list~Task~
        -_fits_in_window(task, window) bool
    }

    class DailyPlan {
        +list~ScheduledTask~ scheduled_tasks
        +list~Task~ skipped_tasks
        +total_minutes_used int
        +explain() string
        +to_display_format() dict
    }

    Owner "1" --> "1..*" Pet : owns
    Owner "1" --> "0..*" TimeBlock : busy_blocks
    Pet "1" --> "0..*" Task : has
    Task "0..1" --> "1" TimeBlock : preferred_time_window
    Task --> Category : category
    Task --> Priority : priority
    Scheduler --> DailyPlan : generates
    DailyPlan "1" --> "0..*" ScheduledTask : contains
    ScheduledTask --> Task : wraps
