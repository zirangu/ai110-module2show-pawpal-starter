classDiagram
    class Category {
        <<enumeration>>
        WALK
        FEED
        MEDS
        ENRICHMENT
        GROOMING
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONE_TIME
        DAILY
        WEEKLY
    }

    class Owner {
        +string name
        +dict preferences
        +time day_start_time
        +time day_end_time
        +list~TimeBlock~ busy_blocks
        +list~Pet~ pets
        +add_pet(pet) void
        +all_tasks() list~Task~
        +filter_tasks(status, pet_name) list~Task~
    }

    class Pet {
        +string id
        +string name
        +string species
        +string notes
        +list~Task~ tasks
        +add_task(task) void
        +complete_task(task_id) Task?
    }

    class TimeBlock {
        +time start_time
        +time end_time
        +string label
        +overlaps(other) bool
    }

    class Task {
        +string id
        +string title
        +Category category
        +int duration_minutes
        +Priority priority
        +TimeBlock preferred_time_window
        +bool is_required
        +string status
        +date due_date
        +date completed_date
        +Frequency frequency
        +mark_complete() void
        +next_occurrence() Task?
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time
        +overlaps(other) bool
    }

    class Scheduler {
        +generate_plan(tasks, owner) DailyPlan
        +check_conflicts(plan) list~string~
        -_due_today(tasks) list~Task~
        -_get_free_windows(owner) list~TimeBlock~
        -_sort_by_priority(tasks) list~Task~
        -_sort_by_constraint(tasks, free_windows) list~Task~
        -_fits_in_window(task, window) bool
    }

    class DailyPlan {
        +list~ScheduledTask~ scheduled_tasks
        +list~Task~ skipped_tasks
        +total_minutes_used int
        +explain() string
        +to_display_format() dict
        +find_conflicts() list~tuple~
        +conflict_warnings() list~string~
    }

    Owner "1" --> "1..*" Pet : owns
    Owner "1" --> "0..*" TimeBlock : busy_blocks
    Pet "1" --> "0..*" Task : has
    Task "0..1" --> "1" TimeBlock : preferred_time_window
    Task --> Category : category
    Task --> Priority : priority
    Task --> Frequency : frequency
    Task --> Task : next_occurrence
    Scheduler --> DailyPlan : generates
    DailyPlan "1" --> "0..*" ScheduledTask : contains
    ScheduledTask --> Task : wraps
